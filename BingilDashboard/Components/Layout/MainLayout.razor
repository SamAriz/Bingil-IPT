@inherits LayoutComponentBase

@* Main layout used by pages in the app. Structure:
   - sidebar: navigation menu
   - main: top row links and the content area where page components render (@Body)
*@
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Built-in Blazor error UI that appears when an unhandled exception bubbles to the client. *@
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
