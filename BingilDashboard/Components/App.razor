<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Preload framework resources required by interactive components *@
    <ResourcePreloader />

    @* CSS bundles: Bootstrap + app styles + component-scoped styles *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BingilDashboard.styles.css"]" />

    @* Import map for client-side module resolution (if used) *@
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Allows pages to add content to the head (title, meta tags) *@
    <HeadOutlet />
</head>

<body>
    @* Router and UI placeholders *@
    <Routes />
    <ReconnectModal />

    @* Blazor WebAssembly/Server script that boots the interactive runtime *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
