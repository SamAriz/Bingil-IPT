        <h1>About me</h1>
        <p>I am a dedicated student pursuing a Bachelor of Science in Information Technology at Southern Christian College. I am passionate about web development and enjoy creating interactive and user-friendly applications.</p>
    </div>
    <div class="quote">
        <button class="btn btn-primary" @onclick="GetQuote">Get Quote</button>

        @if (Quote != null)
        {
            <p>"@Quote.quote"</p>
            <p>- @Quote.author</p>
        }
    </div>
</div>
@code{

    private string SelectedApi = "";
    private Quote? Quote;


    private void ShowQuote()
    {
        SelectedApi = SelectedApi == "quote" ? "" : "quote";
    }

    private async Task GetQuote()
    {
        var result = await ApiService.GetQuoteAsync();
        Quote = result;
    }
}