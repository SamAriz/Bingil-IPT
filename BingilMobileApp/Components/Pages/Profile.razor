@page "/"
@using BingilMobileApp.Models
@inject BingilMobileApp.Services.ApiService ApiService
@inject BingilMobileApp.Services.ProfileApiClient ProfileApi

<PageTitle>Profile</PageTitle>

<div class="duo-root">
    <header class="duo-header">
        <div class="duo-brand">
            <div class="duo-owl">🦉</div>
            <div class="duo-title">Sam's Profile</div>
        </div>
    </header>

    <main class="duo-main">
        <aside class="duo-aside">
            @if (Info == null)
            {
                <div class="card">
                    <h3>PROFILE INFO</h3>
                    @if (ProfileError != null)
                    {
                        <p class="error">@ProfileError</p>
                    }
                    else
                    {
                        <p class="muted">Loading...</p>
                    }
                </div>
            }
            else
            {
                <div class="avatar-card">
                    <img src="/img/profile-image.jpg" alt="profile" />
                    <h1>@Info.Name</h1>
                    <p class="role">@Info.Role</p>
                </div>

                <div class="card">
                    <h3>CONTACT</h3>
                    <p><span class="icon">📞</span> @Info.Contact.Phone</p>
                    <p><span class="icon">✉️</span> @Info.Contact.Email</p>
                    <p><span class="icon">📍</span> @Info.Contact.Address</p>
                </div>

                <div class="card">
                    <h3>SKILLS</h3>
                    <ul>
                        @foreach (var skill in Info.Skills)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                </div>

                <div class="card">
                    <h3>LANGUAGES</h3>
                    <ul>
                        @foreach (var language in Info.Languages)
                        {
                            <li>@language</li>
                        }
                    </ul>
                </div>

                <div class="card small">
                    <h3>HOBBIES</h3>
                    <ul>
                        @foreach (var hobby in Info.Hobbies)
                        {
                            <li>@hobby</li>
                        }
                    </ul>
                </div>

                <div class="card small">
                    <h3>WEAKNESS</h3>
                    <ul>
                        @foreach (var weakness in Info.Weaknesses)
                        {
                            <li>@weakness</li>
                        }
                    </ul>
                </div>
            }
        </aside>

        <section class="duo-content">
            <div class="card">
                <h2>PROFILE</h2>
                <p>I am an IT student with experience in a variety of programming languages and a track record of delivering high-quality code...</p>
            </div>

            <div class="exp-row">
                <div class="exp-col">
                    <div class="card">
                        <h2>EXPERIENCES</h2>
                        <div class="experience-item">
                            <ul>
                                @foreach (var item in Info?.Experiences ?? new List<string>())
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="exp-col">
                    <div class="card">
                        <h2>DESCRIPTION</h2>
                        <ul>
                            @foreach (var item in Info?.Descriptions ?? new List<string>())
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>


            <div class="card actions">
                <a href="https://youtu.be/dQw4w9WgXcQ" target="_blank" class="duo-btn danger"><span class="play">▶</span> Play ME!</a>
            </div>

            <!-- APIs embedded on homepage -->
            <section id="apis" class="card api-panel" style="margin-top:20px;">
                <h2 style="margin-bottom:12px;color:var(--duo-accent);">APIs</h2>
                <div class="api-grid">
                    <div class="api-section">
                        <h3>My Details</h3>
                        <div class="row controls">
                            <button class="btn primary" @onclick="LoadDetails" disabled="@DetailsLoading">Load</button>
                        </div>
                        @if (DetailsLoading)
                        {
                            <p class="muted">Loading...</p>
                        }
                        else if (!string.IsNullOrEmpty(DetailsError))
                        {
                            <p class="error">@DetailsError</p>
                        }
                        else if (DetailsResult != null)
                        {
                            <ul>
                                <li><strong>Birthday:</strong> @Show(DetailsResult.Birthday)</li>
                                <li><strong>Age:</strong> @(DetailsResult.Age?.ToString() ?? "Not set")</li>
                                <li><strong>ID:</strong> @Show(DetailsResult.StudentId)</li>
                                <li><strong>School:</strong> @Show(DetailsResult.School)</li>
                                <li><strong>Course:</strong> @Show(DetailsResult.Course)</li>
                            </ul>
                        }
                    </div>

                    <div class="api-section">
                        <h3>Pokemon Lookup</h3>
                        <div class="row controls">
                            <input class="input" placeholder="Name or ID (e.g. pikachu or 25)" @bind="PokemonInput" @bind:event="oninput" @onkeydown="OnPokemonKeyDown" />
                            <button class="btn primary" @onclick="LookupPokemon" disabled="@PokemonLoading">Lookup</button>
                        </div>
                        @if (PokemonLoading)
                        {
                            <p class="muted">Searching...</p>
                        }
                        else if (!string.IsNullOrEmpty(PokemonError))
                        {
                            <p class="error">@PokemonError</p>
                        }
                        else if (PokemonResult != null)
                        {
                            <div class="result">
                                @if (!string.IsNullOrEmpty(PokemonResult.sprites.front_default))
                                {
                                    <img src="@PokemonResult.sprites.front_default" alt="sprite" />
                                }
                                <div>
                                    <p><strong>@PokemonResult.name</strong></p>
                                    <p class="muted">Types: @string.Join(", ", PokemonResult.types.Select(t => t.type.name))</p>
                                    <p class="muted">Height: @PokemonResult.height • Weight: @PokemonResult.weight</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="api-section">
                        <h3>IP Lookup</h3>
                        <div class="row controls">
                            <input class="input" placeholder="IP (leave blank for caller)" @bind="IpInput" @bind:event="oninput" @onkeydown="OnIpKeyDown" />
                            <button class="btn primary" @onclick="LookupIp" disabled="@IpLoading">Lookup</button>
                        </div>
                        @if (IpLoading)
                        {
                            <p class="muted">Looking up...</p>
                        }
                        else if (!string.IsNullOrEmpty(IpError))
                        {
                            <p class="error">@IpError</p>
                        }
                        else if (IpResult != null)
                        {
                            <ul>
                                <li><strong>IP:</strong> @(IpResult.ip ?? IpResult.query)</li>
                                @if (IpResult.bogon == true)
                                {
                                    <li class="muted">Private or reserved address — no location data available.</li>
                                }
                                else
                                {
                                    <li><strong>Location:</strong> @IpLocation(IpResult)</li>
                                    <li><strong>ISP:</strong> @(IpResult.isp ?? IpResult.org)</li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="api-section">
                        <h3>Draw a Card</h3>
                        <div class="row controls">
                            <button class="btn primary" @onclick="DrawCard" disabled="@CardLoading">Draw</button>
                        </div>
                        @if (CardLoading)
                        {
                            <p class="muted">Drawing...</p>
                        }
                        else if (!string.IsNullOrEmpty(CardError))
                        {
                            <p class="error">@CardError</p>
                        }
                        else if (LastCard != null)
                        {
                            <div class="result">
                                <img src="@LastCard.image" alt="card" />
                                <div>
                                    <p><strong>@LastCard.value of @LastCard.suit</strong></p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

        </section>
    </main>

    <footer class="duo-footer">Profile powered by Blazor</footer>
</div>

@code {
    // Profile info loaded from our own /api/profile endpoint
    private ProfileInfo? Info { get; set; }
    private string? ProfileError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Info = await ProfileApi.GetProfileAsync();
        }
        catch (Exception ex)
        {
            ProfileError = $"Could not load profile info: {ex.Message}";
        }
    }

    // My Details (our own /api/details)
    private bool DetailsLoading { get; set; }
    private string? DetailsError { get; set; }
    private DetailsInfo? DetailsResult { get; set; }

    // Pokemon
    private string PokemonInput { get; set; } = string.Empty;
    private bool PokemonLoading { get; set; }
    private string? PokemonError { get; set; }
    private PokemonResult? PokemonResult { get; set; }

    // IP Lookup
    private string IpInput { get; set; } = string.Empty;
    private bool IpLoading { get; set; }
    private string? IpError { get; set; }
    private IpLookupResult? IpResult { get; set; }

    // Draw card
    private bool CardLoading { get; set; }
    private string? CardError { get; set; }
    private PlayingCard? LastCard { get; set; }

    private static string Show(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private async Task LoadDetails()
    {
        if (DetailsLoading) return;
        DetailsLoading = true;
        DetailsError = null;
        DetailsResult = null;
        try
        {
            DetailsResult = await ProfileApi.GetDetailsAsync();
            if (DetailsResult == null) DetailsError = "No details returned.";
        }
        catch (Exception ex)
        {
            DetailsError = ex.Message;
        }
        finally
        {
            DetailsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnPokemonKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LookupPokemon();
    }

    private async Task OnIpKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LookupIp();
    }

    // ipinfo.io and ip-api.com name their fields differently — accept either
    private static string IpLocation(IpLookupResult r)
    {
        var parts = new[] { r.city, r.region ?? r.regionName, r.country }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(", ", parts);
        var zip = r.postal ?? r.zip;
        return string.IsNullOrWhiteSpace(zip) ? text : $"{text} ({zip})";
    }

    private async Task LookupPokemon()
    {
        if (PokemonLoading) return;
        PokemonLoading = true;
        PokemonError = null;
        PokemonResult = null;
            try
        {
            if (string.IsNullOrWhiteSpace(PokemonInput))
            {
                PokemonError = "Enter a name or id.";
                return;
            }
            var res = await ApiService.GetPokemonAsync(PokemonInput.Trim());
                if (res == null)
                {
                    PokemonError = ApiService.LastError ?? "Pokemon not found.";
                }
                else
                {
                    PokemonResult = res;
                }
        }
        catch (Exception ex)
        {
            PokemonError = ex.Message;
        }
        finally
        {
            PokemonLoading = false;
            StateHasChanged();
        }
    }

    private async Task LookupIp()
    {
        if (IpLoading) return;
        IpLoading = true;
        IpError = null;
        IpResult = null;
            try
        {
            var ip = IpInput ?? string.Empty;
            var res = await ApiService.GetIpLookupAsync(ip);
                if (res == null)
                {
                    IpError = ApiService.LastError ?? "No result.";
                }
                else
                {
                    IpResult = res;
                }
        }
        catch (Exception ex)
        {
            IpError = ex.Message;
        }
        finally
        {
            IpLoading = false;
            StateHasChanged();
        }
    }

    private async Task DrawCard()
    {
        if (CardLoading) return;
        CardLoading = true;
        CardError = null;
        LastCard = null;
            try
        {
            var c = await ApiService.DrawCardAsync();
                if (c == null) CardError = ApiService.LastError ?? "No card returned.";
                else LastCard = c;
        }
        catch (Exception ex)
        {
            CardError = ex.Message;
        }
        finally
        {
            CardLoading = false;
            StateHasChanged();
        }
    }
}
